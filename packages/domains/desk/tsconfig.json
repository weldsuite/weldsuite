{
  "extends": "@weldsuite/typescript-config/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
