{
  "extends": "@weldsuite/typescript-config/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": false,
    // @weldsuite/notifications re-exports prop types from @weldsuite/emails,
    // which ships its templates as .tsx source (no build step) — anything
    // that pulls in those types needs a jsx mode to resolve them.
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
