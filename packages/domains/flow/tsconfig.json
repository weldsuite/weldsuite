{
  "extends": "@weldsuite/typescript-config/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // @weldsuite/emails exports its templates as .tsx source (no build step),
    // so anything that imports it — even just for sendSystemEmail — needs a
    // jsx mode to resolve those files' types. Matches the emails package's
    // own tsconfig.
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": false,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
