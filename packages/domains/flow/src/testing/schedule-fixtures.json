        ]
      },
      "move": { "taskId": "C", "dueDate": "2026-11-12" },
      "expected": {
        "ok": true,
        "task": { "startDate": "2026-11-10", "dueDate": "2026-11-12" },
        "moved": [{ "taskId": "C", "fromStart": "2026-11-11", "fromFinish": "2026-11-13", "toStart": "2026-11-10", "toFinish": "2026-11-12", "shiftDays": -1 }],
        "newConflicts": [{ "linkId": "l2", "successorId": "C", "requiredStart": "2026-11-11", "plannedStart": "2026-11-10", "shortByDays": 1 }],
        "before": { "finish": "2026-11-13", "goLiveSlackDays": null },
        "after": { "finish": "2026-11-12", "goLiveSlackDays": null }
      }
    },
    {
      "name": "a move that leaves the dependents enough room pushes nobody",
