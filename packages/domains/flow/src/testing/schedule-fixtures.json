          "C": { "durationDays": 3, "earlyStart": "2026-11-04", "earlyFinish": "2026-11-06", "shiftDays": 2 },
          "D": { "earlyStart": "2026-11-02", "earlyFinish": "2026-11-02", "shiftDays": 0 },
          "E": { "earlyStart": "2026-11-06", "earlyFinish": "2026-11-09", "shiftDays": 4 },
          "F": { "earlyStart": "2026-11-11", "earlyFinish": "2026-11-11", "shiftDays": 7, "totalFloat": 0, "critical": true }
        }
      }
    },
    {
