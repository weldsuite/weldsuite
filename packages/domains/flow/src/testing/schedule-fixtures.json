  "moves": [
    {
      "name": "moving the first task of a chain pushes every dependent and eats the go-live float",
      "input": {
        "tasks": [
          { "id": "A", "status": "in_progress", "startDate": "2026-11-02", "dueDate": "2026-11-06" },
          { "id": "B", "status": "todo", "startDate": "2026-11-09", "dueDate": "2026-11-10" },
          { "id": "C", "status": "todo", "startDate": "2026-11-11", "dueDate": "2026-11-13" },
          { "id": "X", "status": "todo", "startDate": "2026-11-02", "dueDate": "2026-11-03" }
        ],
        "links": [
          { "id": "l1", "predecessorId": "A", "successorId": "B", "type": "fs", "lagDays": 0 },
          { "id": "l2", "predecessorId": "B", "successorId": "C", "type": "fs", "lagDays": 0 }
        ],
        "goLive": "2026-11-20"
      },
      "move": { "taskId": "A", "startDate": "2026-11-04" },
      "expected": {
        "ok": true,
        "task": { "startDate": "2026-11-04", "dueDate": "2026-11-10" },
        "moved": [
          { "taskId": "A", "fromStart": "2026-11-02", "fromFinish": "2026-11-06", "toStart": "2026-11-04", "toFinish": "2026-11-10", "shiftDays": 2 },
          { "taskId": "B", "fromStart": "2026-11-09", "fromFinish": "2026-11-10", "toStart": "2026-11-11", "toFinish": "2026-11-12", "shiftDays": 2 },
          { "taskId": "C", "fromStart": "2026-11-11", "fromFinish": "2026-11-13", "toStart": "2026-11-13", "toFinish": "2026-11-17", "shiftDays": 2 }
        ],
        "newConflicts": [{ "linkId": "l1", "successorId": "B", "requiredStart": "2026-11-11", "shortByDays": 2 }],
        "before": { "finish": "2026-11-13", "goLiveSlackDays": 5 },
        "after": { "finish": "2026-11-17", "goLiveSlackDays": 3 }
      }
    },
    {
      "name": "moving a task earlier moves nothing else and flags the conflict with its predecessor",
      "input": {
        "tasks": [
          { "id": "A", "status": "in_progress", "startDate": "2026-11-02", "dueDate": "2026-11-06" },
          { "id": "B", "status": "todo", "startDate": "2026-11-09", "dueDate": "2026-11-10" },
          { "id": "C", "status": "todo", "startDate": "2026-11-11", "dueDate": "2026-11-13" }
