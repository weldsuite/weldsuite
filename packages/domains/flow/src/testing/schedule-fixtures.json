      "move": { "taskId": "A" },
      "expected": { "ok": false, "code": "dates_missing", "message": "Give a start date, a due date, or both" }
    },
    {
      "name": "a due date before the start date",
      "input": { "tasks": [{ "id": "A", "status": "todo", "startDate": "2026-11-02", "dueDate": "2026-11-03" }], "links": [] },
      "move": { "taskId": "A", "startDate": "2026-11-09", "dueDate": "2026-11-06" },
      "expected": { "ok": false, "code": "dates_reversed", "message": "The due date cannot be before the start date" }
    },
    {
      "name": "a date that does not exist",
      "input": { "tasks": [{ "id": "A", "status": "todo", "startDate": "2026-11-02", "dueDate": "2026-11-03" }], "links": [] },
      "move": { "taskId": "A", "startDate": "2026-02-30" },
      "expected": { "ok": false, "code": "dates_invalid", "message": "Dates must be real dates in the form YYYY-MM-DD" }
    }
  ]
