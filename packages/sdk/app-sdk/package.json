{
  "name": "@weldsuite/app-sdk",
  "version": "0.5.0",
  "description": "SDK for building WeldSuite apps — iframe bridge, workspace-scoped API client, React bindings, and suite UI kit",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./ui/styles.css": "./dist/ui/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c && node scripts/copy-ui-css.mjs",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "weldsuite",
    "weldapp",
    "sdk",
    "iframe",
    "bridge",
    "apps",
    "ui"
  ],
  "author": "WeldSuite",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/weldsuite/weldsuite.git",
    "directory": "packages/sdk/app-sdk"
  },
  "homepage": "https://www.npmjs.com/package/@weldsuite/app-sdk",
  "bugs": {
    "url": "https://github.com/weldsuite/weldsuite/issues"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.9.6",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.6.2",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": false
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
