{
  "name": "@weldsuite/panel-sdk",
  "version": "0.2.0",
  "description": "WeldPanel analytics SDK: pageviews, clicks, custom events, identity, frustration signals and session recordings for websites and web apps",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/global.ts",
    "./src/recorder-global.ts",
    "./dist/panel.global.js",
    "./dist/panel-recorder.global.js"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./wire": "./src/wire.ts",
    "./install": "./src/install.ts",
    "./recorder": "./src/recorder.ts",
    "./server": "./src/server.ts",
    "./dist/panel.global.js": "./dist/panel.global.js",
    "./dist/panel-recorder.global.js": "./dist/panel-recorder.global.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rrweb/record": "2.1.7",
    "rrweb": "2.1.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7",
    "vitest": "^4.1.12"
  }
}
