{
  "name": "@weldsuite/cli",
  "version": "0.1.0",
  "description": "CLI for building, deploying and publishing WeldSuite apps",
  "private": false,
  "type": "module",
  "bin": {
    "weld": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/**/*.test.js",
    "prepublishOnly": "pnpm run build && find dist -name '*.test.js' -delete"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "weldsuite",
    "weldapp",
    "cli",
    "apps",
    "deploy"
  ],
  "author": "WeldSuite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/weldsuite/weldsuite.git",
    "directory": "packages/sdk/cli"
  },
  "homepage": "https://www.npmjs.com/package/@weldsuite/cli",
  "bugs": {
    "url": "https://github.com/weldsuite/weldsuite/issues"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
