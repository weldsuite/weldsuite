{
  "name": "@weldsuite/forms-embed",
  "license": "MIT",
  "version": "0.1.0",
  "description": "Embed WeldForms forms on any website: inline, popup, slider, popover or full page",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "src", "LICENSE"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
