          "choices": [
            { "id": "c_q3_paris", "label": "Paris", "score": 2, "correct": true },
            { "id": "c_q3_lyon", "label": "Lyon" }
          ]
        }
      },
      {
        "id": "b_mood",
        "ref": "mood",
        "type": "picture_choice",
        "title": "How do you feel?",
        "properties": {
          "multiple": true,
          "choices": [
            { "id": "c_happy", "label": "Happy", "score": 0.1 },
            { "id": "c_sad", "label": "Sad", "score": 0.2 }
          ]
        }
      },
      { "id": "b_name", "ref": "name", "type": "short_text", "title": "Your name" }
    ],
    "endings": [
      { "id": "e_try", "ref": "try_again", "title": "Try again", "showScore": true, "showAnswers": true },
      { "id": "e_good", "ref": "good", "title": "Good", "showScore": true },
      { "id": "e_perfect", "ref": "perfect", "title": "Perfect", "showScore": true }
    ],
    "endingRules": [
      {
        "id": "r_perfect",
        "when": { "op": "and", "conditions": [{ "left": { "type": "variable", "name": "score" }, "operator": "greater_or_equal", "right": { "type": "constant", "value": 4 } }] },
        "endingId": "e_perfect"
      },
      {
        "id": "r_good",
        "when": { "op": "and", "conditions": [{ "left": { "type": "variable", "name": "score" }, "operator": "greater_or_equal", "right": { "type": "constant", "value": 2 } }] },
        "endingId": "e_good"
      }
    ]
  },
  "cases": [
