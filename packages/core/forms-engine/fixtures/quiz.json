            { "id": "c_q1_5", "label": "5", "score": 0 }
          ]
        }
      },
      {
        "id": "b_q2",
        "ref": "q2",
        "type": "multiple_choice",
        "title": "Which are prime?",
        "required": true,
        "properties": {
          "multiple": true,
          "choices": [
            { "id": "c_q2_2", "label": "2", "score": 0.5, "correct": true },
            { "id": "c_q2_3", "label": "3", "score": 0.5, "correct": true },
            { "id": "c_q2_4", "label": "4", "score": -1 }
          ]
        }
      },
      {
        "id": "b_q3",
        "ref": "q3",
        "type": "dropdown",
        "title": "Capital of France?",
