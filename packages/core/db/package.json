{
  "name": "@weldsuite/db",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "db:generate": "cd ../../../rust && cargo run -q -p weldsuite-schema --bin weldsuite-schema -- generate tenant",
    "db:generate:master": "cd ../../../rust && cargo run -q -p weldsuite-schema --bin weldsuite-schema -- generate master",
    "db:generate:personal": "drizzle-kit generate --config=drizzle.personal.config.ts && node scripts/prune-snapshots.mjs",
    "db:prune-snapshots": "node scripts/prune-snapshots.mjs",
    "db:migrate:master": "drizzle-kit migrate --config=drizzle.master.config.ts",
    "db:migrate:personal": "drizzle-kit migrate --config=drizzle.personal.config.ts",
    "seed:ai-gateway-credits": "tsx scripts/seed-ai-gateway-credits.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@weldsuite/app-api-client": "workspace:*",
    "@weldsuite/permissions": "workspace:*",
    "@weldsuite/text": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@clerk/nextjs": "^6.39.3",
    "react": "^18.0.0 || ^19.0.0",
    "@electric-sql/pglite": "^0.4.5"
  },
  "peerDependenciesMeta": {
    "@clerk/nextjs": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@clerk/nextjs": "^6.39.3",
    "@electric-sql/pglite": "^0.4.5",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@weldsuite/eslint-config": "workspace:*",
    "@weldsuite/typescript-config": "workspace:*",
    "drizzle-kit": "^0.30.5",
    "react": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./lib": "./src/lib/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./migrations/personal": "./drizzle/personal-migrations",
    "./testing/pglite": "./src/testing/pglite.ts"
  }
}
