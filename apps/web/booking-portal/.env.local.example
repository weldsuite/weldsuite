# Master database (workspace routing)
MASTER_DATABASE_URL=postgresql://user:password@host/master_db?sslmode=require

# Shared personal Neon DB (consumer WeldCalendar booking pages at /p/{slug}).
# Same value as personal-api DATABASE_URL_PERSONAL. Alias: PERSONAL_DATABASE_URL.
DATABASE_URL_PERSONAL=postgresql://user:password@host/personal_db?sslmode=require

# Neon API key (fallback for resolving tenant database URLs)
NEON_API_KEY=neon_api_key_here

# Encryption key for decrypting stored database URLs (64-char hex, AES-256)
DATABASE_ENCRYPTION_KEY=your_64_char_hex_key_here

# Resend API key (for sending booking confirmation emails)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Signs the cancel / reschedule links in booking emails (HMAC). Optional: when
# unset, a key is derived from DATABASE_ENCRYPTION_KEY above. Changing it
# invalidates links that were already sent.
# BOOKING_LINK_SECRET=long_random_string

# Public origin of the portal used in those links. Optional: defaults to the
# host the request arrived on.
# BOOKING_PORTAL_URL=https://book.weldsuite.org
