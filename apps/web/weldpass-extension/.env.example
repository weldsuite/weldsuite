# Copy to .env.production (used by `pnpm build`) and/or .env.development (used
# by `pnpm dev`) and fill in. None of these are secrets: they end up in the
# extension bundle and its manifest. The build works without them; the popup
# then shows "Extension not configured".

# Publishable key of the SAME Clerk instance the WeldSuite web app uses.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx

# The host whose Clerk cookie the extension reads to reuse the web session
# (Clerk's `syncHost`). Which host that is depends on the Clerk instance type:
#   production instance (pk_live_…): the Clerk Frontend API domain,
#     e.g. https://clerk.weldsuite.org
#   development instance (pk_test_…): the web app's own origin,
#     e.g. http://localhost or https://app-test.weldsuite.org
# See README.md → "Clerk configuration".
VITE_SYNC_HOST=https://clerk.weldsuite.org

# app-api origin. Requests go to ${VITE_API_URL}/api/weldpass/...
VITE_API_URL=https://app-api.weldsuite.org

# The web app opened by the "Open WeldSuite" button. Optional: defaults to
# VITE_SYNC_HOST, which is only right when the sync host IS the web app.
VITE_APP_URL=https://app.weldsuite.org

# Optional. The extension's public key (base64; becomes the manifest's "key"),
# so an unpacked build keeps one extension ID on every machine. See README.md.
VITE_EXTENSION_KEY=
