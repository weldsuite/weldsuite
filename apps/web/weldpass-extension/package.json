{
  "name": "weldpass-extension",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "zip": "tsc -p tsconfig.json --noEmit && vite build --mode store && node scripts/zip.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "screenshots": "playwright test -c e2e/screenshots.config.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@weldsuite/api-client": "workspace:*",
    "@weldsuite/app-api-client": "workspace:*",
    "@weldsuite/mobile-platform": "workspace:*",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "fflate": "^0.8.2",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
