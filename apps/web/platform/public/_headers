# Cloudflare Pages cache rules for the platform SPA.
# Copied verbatim into dist/ by Vite (public/ assets ship as-is).
#
# Companion: public/assets/404.html. Without that file, Pages SPA mode answers
# a missing hashed chunk (e.g. a stale tab requesting /assets/old-hash.js)
# with the root index.html as 200 text/html. The browser then rejects the
# module script ("Expected a JavaScript-or-Wasm module script but the server
# responded with a MIME type of text/html"). Worse, the /assets/* rule below
# would stamp that HTML response with immutable caching and poison the edge.
# assets/404.html makes unmatched paths under /assets/ return a real 404
# while root client routes keep SPA fallback behaviour.

# Content-hashed build output (e.g. /assets/index-DFsOehJK.js). Long-lived
# cache is fine because the filename changes when the bytes change — but do
# NOT use `immutable`. When Pages briefly answers a miss with a 404 (or, before
# assets/404.html, with the SPA shell), an immutable edge HIT can poison that
# URL for a year even after the real file is restored (seen 2026-08-04 on
# app.weldsuite.org for index-D6fm6ay0.js). Without immutable, a hard reload
# can recover after purge/TTL.
/assets/*
  Cache-Control: public, max-age=31536000

# Never cache the assets 404 document itself (and don't let a deploy-race 404
# for a not-yet-propagated hash stick around for a year).
/assets/404.html
  Cache-Control: no-store

# The entry document maps every request to the current build's hashed chunks.
# It MUST be revalidated on each load — otherwise a stale index.html keeps
# pointing tabs at chunk hashes a redeploy already deleted (the "Failed to
# fetch dynamically imported module" / wrong-MIME error).
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Runtime environment shim — not content-hashed, must never be cached.
/__ENV.js
  Cache-Control: no-cache
