# Copy to .env.local and fill in. Never commit real values.

# Your WeldSuite API address (the hosted EU edition, or your own install).
WELDCOMMERCE_API_URL=https://api.weldsuite.example

# A PRIVATE storefront key (wcs_...) of a storefront channel:
# Settings -> Apps -> WeldCommerce -> Channels -> (channel) -> Keys.
# It stays on the server; never expose it to the browser (no NEXT_PUBLIC_ prefix).
WELDCOMMERCE_KEY=wcs_replace_me

# The shop's public https address. Mollie sends shoppers back here after paying,
# and order confirmation emails link to it. Mollie needs https: use a tunnel in development.
SHOP_URL=https://shop.example.com

# Optional: how prices and dates are shown.
SHOP_LOCALE=en-IE
SHOP_TIME_ZONE=Europe/Amsterdam
