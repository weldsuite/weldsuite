# Copy to .env.local and fill in. Never commit real values (these end up in the
# browser bundle, which is why only a publishable key may go here).

# Your WeldSuite server (the hosted EU edition, or your own install).
VITE_WELDCOMMERCE_API_URL=https://api.weldsuite.example

# A PUBLISHABLE storefront key (wcp_...) of a storefront channel:
# Settings -> Apps -> WeldCommerce -> Channels -> (channel) -> Keys.
# It works from the channel's WeldSuite-hosted addresses and from the key's allowed origins.
# Never a private key (wcs_...): the build refuses one.
VITE_WELDCOMMERCE_KEY=wcp_replace_me

# The shop's public https address. Mollie sends shoppers back here after paying,
# order confirmation emails link to it, and prerendered pages use it for canonical URLs.
VITE_SHOP_URL=https://shop.example.com

# Optional: how prices are shown.
VITE_SHOP_LOCALE=en-IE
