# WeldSuite admin console (TanStack Start on Node, ADR FE-018)
#
# Copy this file to .env for `pnpm dev`. On Kubernetes the Helm chart sets
# these (rust/deploy/helm/weldsuite, the `admin` block).

# Staff sign-in over OIDC (Zitadel, or WeldID). Only accounts with an active
# admin_users row get in.
ADMIN_OIDC_ISSUER=https://auth.example.eu
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
# The organization of the staff's own accounts (Zitadel's `WeldSuite Staff`);
# no other account gets in. Leave it unset with WeldID.
# ADMIN_OIDC_ORG_ID=
# Where staff open the console; the redirect URI is {ADMIN_PUBLIC_URL}/auth/callback.
ADMIN_PUBLIC_URL=http://localhost:3001
# 32+ random characters; seals the session cookie.
ADMIN_SESSION_SECRET=

# Master database (Postgres over TCP).
DATABASE_URL_MASTER=postgresql://...
# The keyring that opens the tenant database URLs the Rust server stored.
DATABASE_ENCRYPTION_KEY=
# DATABASE_ENCRYPTION_KEY_V2=
# Tenant database clients kept open (least recently used closes first).
# ADMIN_TENANT_POOLS=20

# System email over SMTP, as the Rust server sends it. Without it, the
# workspace-deletion and access-request emails are skipped (warning only).
# SMTP_URL=smtp://user:pass@mta:587
# SYSTEM_EMAIL_FROM=notifications@example.eu

# Where the platform lives, for the links in the access approved / rejected
# emails (WeldReach). Defaults to https://app.weldsuite.org.
# PLATFORM_APP_URL=https://app.example.eu

# Respondent portal of WeldForms, for the public links on the WeldForms page.
# Defaults to https://forms.weldsuite.org.
# FORMS_PORTAL_URL=https://forms.example.eu

# mail-api's internal outbound-guard API (/internal/outbound/*): the live view
# on the Outbound mail screens, "reload the policy now" and "Run AI review".
# OUTBOUND_ADMIN_SECRET must equal mail-api's secret of the same name (32+
# random characters). Without these, the screens work from the master DB and
# say that live data is unavailable.
# MAIL_API_URL=
# OUTBOUND_ADMIN_SECRET=

# `pnpm start:node` only.
# PORT=3000
