EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key
EXPO_PUBLIC_APP_API_URL=http://localhost:8789
EXPO_PUBLIC_EAS_PROJECT_ID=

# Server choice (docs/plans/mobile-server-choice.md): `on` shows the server
# picker (WeldSuite cloud / EU / self-hosted). EXPO_PUBLIC_EU_SERVER_URL is the
# EU edition's origin; unset hides EU.
EXPO_PUBLIC_SERVER_PICKER=on
EXPO_PUBLIC_EU_SERVER_URL=https://app.test.weldsuite.eu
