{
  "expo": {
    "name": "WeldFlow",
    "slug": "weldflow-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "weldflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weldsuite.weldflow",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.weldsuite.weldflow",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "@clerk/expo",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0B0B12"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#F55C53"
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": { "light": "#E84C3D", "dark": "#E84C3D" },
              "colorControlActivated": { "light": "#E84C3D", "dark": "#E84C3D" },
              "colorControlHighlight": { "light": "#E84C3D", "dark": "#E84C3D" },
              "windowBackground": { "light": "#FFFFFF", "dark": "#1C1C1E" },
              "textColorPrimary": { "light": "#000000", "dark": "#FFFFFF" },
              "textColorSecondary": { "light": "#6B7280", "dark": "#A1A1AA" },
              "textColorPrimaryInverse": { "light": "#FFFFFF", "dark": "#FFFFFF" }
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "728d3ec2-f087-42a3-b5bb-74beffc3759c"
      }
    },
    "owner": "weldsuite",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/728d3ec2-f087-42a3-b5bb-74beffc3759c",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
