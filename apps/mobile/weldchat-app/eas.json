{
  "cli": {
    "version": ">= 18.0.5",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_EU_SERVER_URL": "https://app.test.weldsuite.eu",
        "EXPO_PUBLIC_SERVER_PICKER": "on"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_EU_SERVER_URL": "https://app.test.weldsuite.eu",
        "EXPO_PUBLIC_SERVER_PICKER": "on"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_EU_SERVER_URL": "https://app.weldsuite.eu",
        "EXPO_PUBLIC_SERVER_PICKER": "on"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6761431861"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
