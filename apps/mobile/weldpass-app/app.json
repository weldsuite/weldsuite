{
  "expo": {
    "name": "WeldPass",
    "slug": "weldpass-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "weldpass",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weldsuite.weldpass",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "WeldPass uses Face ID to unlock your vaults and before it shows or copies a password.",
        "WeldPassKeychainGroup": "$(AppIdentifierPrefix)com.weldsuite.weldpass.shared"
      },
      "entitlements": {
        "com.apple.developer.authentication-services.autofill-credential-provider": true,
        "com.apple.security.application-groups": [
          "group.com.weldsuite.weldpass"
        ],
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.weldsuite.weldpass.shared"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5"
      },
      "package": "com.weldsuite.weldpass",
      "allowBackup": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "WeldPass uses Face ID to unlock your vaults and before it shows or copies a password."
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "10d6f695-5ee3-4cb6-b982-c4e9e0c3633a"
      }
    },
    "owner": "weldsuite"
  }
}
