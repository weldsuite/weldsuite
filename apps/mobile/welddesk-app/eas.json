        "EXPO_PUBLIC_EAS_PROJECT_ID": "13651588-c9db-412f-bdc4-45efd548795f",
        "NODE_ENV": "production",
        "EXPO_PUBLIC_EU_SERVER_URL": "https://app.test.weldsuite.eu",
