# WeldDesk runs on WeldSuite EU and self-hosted servers only (Global is
# retired, ADR OPS-025). Sign-in is the server's own (WeldID on EU); the API,
# realtime and web hosts come from the server's /config.json, so the build
# names only the server. EAS profiles bake the values in: see eas.json.

# The EU server the app starts on. Required: without it the app can't start.
EXPO_PUBLIC_EU_SERVER_URL=https://app.test.weldsuite.eu

# `on` shows "Server · Change" on the sign-in screen and in settings, where a
# self-hosted server can be chosen instead (ADR MOB-006).
EXPO_PUBLIC_SERVER_PICKER=on

# EAS project (@weldsuite/welddesk-app), also in app.json extra.eas.projectId
EXPO_PUBLIC_EAS_PROJECT_ID=13651588-c9db-412f-bdc4-45efd548795f
