# Unified app-api (local: `pnpm --filter app-api dev` on :8789).
# EAS profiles bake test/prod URLs — see eas.json.
EXPO_PUBLIC_APP_API_URL=https://app-api-test.weldsuite.org
EXPO_PUBLIC_REALTIME_URL=wss://realtime-test.weldsuite.org

# EAS project (@weldsuite/welddesk-app) — also in app.json extra.eas.projectId
EXPO_PUBLIC_EAS_PROJECT_ID=13651588-c9db-412f-bdc4-45efd548795f

# Clerk Configuration
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Google OAuth client IDs for Clerk Google sign-in (same instance as WeldBooks / WeldMail)
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
