# Unified app-api (local dev: `pnpm --filter app-api dev` on :8789).
# Test builds use https://app-api-test.weldsuite.org, production builds
# https://app-api.weldsuite.org (see eas.json).
EXPO_PUBLIC_APP_API_URL=https://app-api-test.weldsuite.org

# Clerk Configuration
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Google OAuth client IDs for Clerk Google sign-in (same instance as WeldMail)
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
