# Unified app-api (local dev: `pnpm --filter app-api dev` on :8789).
# Production builds use https://app-api.weldsuite.org (see eas.json).
EXPO_PUBLIC_APP_API_URL=https://app-api-test.weldsuite.org

# Realtime WebSocket
EXPO_PUBLIC_REALTIME_URL=wss://realtime-test.weldsuite.org

# Clerk Configuration
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server choice (weldsuite-documentation/plans/mobile-server-choice.md): `on` shows the server
# picker (WeldSuite cloud / EU / self-hosted) on the sign-in screen and in
# settings. EXPO_PUBLIC_EU_SERVER_URL is the EU edition's origin; unset hides EU.
EXPO_PUBLIC_SERVER_PICKER=on
EXPO_PUBLIC_EU_SERVER_URL=https://app.test.weldsuite.eu

# EAS project id (same value as `expo.extra.eas.projectId` in app.json)
EXPO_PUBLIC_EAS_PROJECT_ID={{EAS_PROJECT_ID}}
