{
  "name": "chat-api",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "deploy:test": "wrangler deploy --env test",
    "dev": "wrangler dev --port 8811",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "@weldsuite/agent-domain": "workspace:*",
    "@weldsuite/api-modules": "workspace:*",
    "@weldsuite/app-api-client": "workspace:*",
    "@weldsuite/chat-domain": "workspace:*",
    "@weldsuite/cloudflare-realtime": "workspace:*",
    "@weldsuite/core-api-client": "workspace:*",
    "@weldsuite/db": "workspace:*",
    "@weldsuite/entity-events": "workspace:*",
    "@weldsuite/flow-domain": "workspace:*",
    "@weldsuite/notifications": "workspace:*",
    "@weldsuite/permissions": "workspace:*",
    "@weldsuite/realtime": "workspace:*",
    "@weldsuite/worker-kit": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.34",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250110.0",
    "@electric-sql/pglite": "^0.4.5",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^5.7",
    "vitest": "^3.2.6",
    "wrangler": "^4.95.0"
  }
}
