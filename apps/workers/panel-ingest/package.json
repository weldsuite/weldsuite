{
  "name": "panel-ingest",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:sdk && wrangler deploy --dry-run --outdir dist",
    "build:sdk": "pnpm --filter @weldsuite/panel-sdk build",
    "deploy:production": "pnpm build:sdk && wrangler deploy --env production",
    "deploy:test": "pnpm build:sdk && wrangler deploy --env test",
    "dev": "pnpm build:sdk && wrangler dev --port 8841",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@weldsuite/panel-domain": "workspace:*",
    "@weldsuite/panel-sdk": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250110.0",
    "@types/node": "^20",
    "typescript": "^5.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.95.0"
  }
}
