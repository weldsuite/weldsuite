{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // @weldsuite/emails exports its templates as .tsx source (no build step),
    // so anything that imports it — even just for sendSystemEmail — needs a
    // jsx mode to resolve those files' types. Matches the emails package's
    // own tsconfig.
    "jsx": "react-jsx",
    "noEmit": true,
    "lib": [
      "ESNext"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
