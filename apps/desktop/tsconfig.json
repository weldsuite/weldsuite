{
  "extends": "@weldsuite/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron"],
    "outDir": "dist",
    // No `rootDir`: this config is type-check only (`noEmit`), and `include`
    // deliberately reaches outside src for electron.vite.config.ts, which
    // `rootDir: "src"` rejected outright (TS6059).
    "noEmit": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts", "electron.vite.config.ts"]
}
