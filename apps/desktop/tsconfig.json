{
  "extends": "@weldsuite/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "electron"],
    // No rootDir/outDir: this project is type-check only (electron-vite owns
    // emit). Setting rootDir here would reject `electron.vite.config.ts`,
    // which lives outside src/ but must still be checked.
    "noEmit": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts", "electron.vite.config.ts"]
}
