    "sendError.onHold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New conversations are paused while we review your workspace’s sending. You can still reply to messages you have received. Contact support if you think this is a mistake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe gesprekken zijn gepauzeerd terwijl we het verzenden van je workspace bekijken. Je kunt nog steeds antwoorden op berichten die je hebt ontvangen. Neem contact op met support als je denkt dat dit een vergissing is."
          }
        }
      }
    },
