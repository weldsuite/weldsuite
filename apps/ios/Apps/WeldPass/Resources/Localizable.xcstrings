    "vaults.notMember": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As a workspace admin you can manage who has access to this vault, but you can’t see the passwords in it. Add yourself as a member to open them."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als werkruimtebeheerder kun je beheren wie toegang heeft tot deze kluis, maar je ziet de wachtwoorden erin niet. Voeg jezelf toe als lid om ze te openen."
          }
        }
      }
    },
