    "salesTax.errors.addressRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ship-to (or bill-to) address with a state and ZIP code is needed to calculate sales tax. Add it to the invoice before finalising."
          }
        },
