          "stringUnit": {
            "state": "translated",
            "value": "Voor het berekenen van sales tax is een afleveradres (of factuuradres) met staat en ZIP-code nodig. Voeg het toe aan de factuur voordat je afrondt."
          }
        }
      }
    },
    "salesTax.errors.commitNotApplicable": {
      "extractionState": "manual",
      "localizations": {
