    "update.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of %@ no longer works with your server. Update it to carry on."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie van %@ werkt niet meer met je server. Werk de app bij om verder te gaan."
