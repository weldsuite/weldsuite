    "lock.noScreenLockDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ keeps your data behind your phone’s screen lock. Set a passcode, PIN or pattern in Settings, then come back."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bewaart je gegevens achter de schermvergrendeling van je telefoon. Stel een toegangscode, pincode of patroon in bij Instellingen en kom dan terug."
          }
        }
      }
    },
