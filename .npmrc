auto-install-peers=true
shamefully-hoist=true
node-linker=hoisted
# Build dependencies one at a time. pnpm 10's hoisted linker copies each built
# package to its other hoisted locations on a worker thread, using paths
# relative to the cwd, while applying a patchedDependencies entry chdirs the
# process. When the two overlap the copy fails with
# ERR_PNPM_ENOENT rename '.../node_modules/_tmp_*' (pnpm/pnpm#13627, #12880).
# Only three packages here run build scripts, so this costs almost nothing.
# Drop it once we're on pnpm >= 11.25, which has the fix.
child-concurrency=1
strict-peer-dependencies=false
public-hoist-pattern[]=*@nextui-org/*
public-hoist-pattern[]=*@radix-ui/*
registry=https://registry.npmjs.org/