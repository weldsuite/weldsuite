+/** The schema's `relations()` exports only: filtered once, so each table scans those instead of every export. */
+export type ExtractRelationsOnly<TSchema extends Record<string, unknown>> = {
+    [K in keyof TSchema as TSchema[K] extends Relations ? K : never]: TSchema[K];
+};
 export type ExtractTablesWithRelations<TSchema extends Record<string, unknown>> = {
     [K in keyof TSchema as TSchema[K] extends Table ? K : never]: TSchema[K] extends Table ? {
         tsName: K & string;
         dbName: TSchema[K]['_']['name'];
         columns: TSchema[K]['_']['columns'];
-        relations: ExtractTableRelationsFromSchema<TSchema, TSchema[K]['_']['name']>;
+        relations: ExtractTableRelationsFromSchema<ExtractRelationsOnly<TSchema>, TSchema[K]['_']['name']>;
         primaryKey: AnyColumn[];
     } : never;
 };
