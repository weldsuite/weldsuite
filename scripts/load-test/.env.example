# WeldSuite pressure tests: copy to scripts/load-test/.env and fill in.
# Real environment variables and command-line options win over this file.

# ---- Where ----------------------------------------------------------------
# global (default): Cloudflare Workers + Clerk. eu: the Rust server + WeldID.
WELD_TARGET=global
# test (default) or production. Production also needs ALLOW_PRODUCTION=yes.
WELD_ENV=test
# ALLOW_PRODUCTION=yes

# EU: the install's domain; api.<domain> serves every module and /v1.
# Default test.weldsuite.eu (weldsuite.eu with WELD_ENV=production).
# EU_DOMAIN=test.weldsuite.eu
# Pin one host instead (a local server, for instance):
# BASE_URL=http://localhost:8789
# PUBLIC_API_URL=http://localhost:8790

# ---- Global: Clerk ----------------------------------------------------------
# Secret key of the Clerk instance app-test.weldsuite.org uses.
CLERK_SECRET_KEY=
# Clerk.session.id from a browser signed in to the test workspace.
CLERK_SESSION_ID=

# ---- EU: WeldID -------------------------------------------------------------
# Sign in once with `pnpm load-test login --target eu`; the refresh token is
# kept in .weldid/ (git-ignored), not here.
# The test workspace: its ws_… id or slug. Several, comma separated, spread
# the virtual users over them (see README, "Capacity of the EU install").
WELD_WORKSPACE=

# ---- Either -----------------------------------------------------------------
# A wsk_ key of the test workspace, for `public` (several, comma separated:
# one per workspace).
WELD_API_KEY=
# A ready-made access token instead of a session (short runs only).
# WELD_TOKEN=

# ---- Tuning -----------------------------------------------------------------
# SCALE=1
# WRITE_RATIO=0.2
# DURATION=5m
# SOAK_DURATION=30m
# THINK=0                 no pause between a user's actions
# P95_READ_MS=800
# P95_WRITE_MS=1500
# MAX_ERROR_RATE=0.01
# BREAK_P95_MS=3000
# VIA_APP_API=1           Global only: everything through app-api's forwarder
