    {
      "name": "3. Access requests",
      "description": "Ask for a permission (notifies the admins over realtime), list mine, resolve one (needs team:update).",
      "item": [
        {
          "name": "Request a permission",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const accessRequestIdBody = pm.response.json();",
                  "if (accessRequestIdBody.data && accessRequestIdBody.data.id) pm.collectionVariables.set('accessRequestId', accessRequestIdBody.data && accessRequestIdBody.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/access-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "access-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permission\": \"team:read\",\n  \"pageLabel\": \"Team\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "My pending requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/access-requests/me/pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "access-requests",
                "me",
                "pending"
              ]
            }
          }
        },
        {
          "name": "Approve it (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/access-requests/{{accessRequestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "access-requests",
                "{{accessRequestId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
