{
  "info": {
    "name": "WeldSuite Rust backend (local)",
    "description": "Calls against the Rust backend from rust/deploy/local (docker compose). Import with the environment that mint-token.mjs writes (.local/weldsuite-local.postman_environment.json): it holds baseUrl and the tokens. `token` is the admin's; put {{memberToken}} in it to call as the member. Run the folders top to bottom: later requests use ids the earlier ones saved.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "accessRequestId",
      "value": ""
    },
    {
      "key": "spaceId",
      "value": ""
    },
    {
      "key": "pageId",
      "value": ""
    }
  ],
  "item": [
