# Every node: name, location labels, the private network for kubelet and
# etcd traffic, an EU DNS resolver, and the directory OpenEBS LocalPV
# provisions volumes under (local NVMe, no Cloud Volumes).
#
# Talos 1.14 keeps these settings in their own documents (HostnameConfig,
# ResolverConfig, TimeSyncConfig, KubeNodeConfig, KubeNetworkConfig), which the
# generated config already holds. Setting the same thing in the v1alpha1
# document too (machine.network, machine.kubelet, cluster.network, …) makes
# Talos refuse the whole config, so patch the documents instead;
# `talosctl validate --mode cloud` checks a rendered config.
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: ${hostname}
---
# CoreDNS forwards to the node resolvers: an EU resolver instead of
# Hetzner's. Quad9 (Swiss foundation); DNS4EU's addresses can replace them.
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 9.9.9.9
  - address: 149.112.112.112
---
apiVersion: v1alpha1
kind: TimeSyncConfig
ntp:
  servers:
    - ntp1.hetzner.de
    - ntp2.hetzner.com
---
apiVersion: v1alpha1
kind: KubeNodeConfig
nodeIP:
  validSubnets:
    - ${nodes_subnet}
labels:
  topology.kubernetes.io/region: ${region}
  topology.kubernetes.io/zone: ${location}
  node.weldsuite.org/pool: ${pool}
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
podSubnets:
  - ${pod_cidr}
serviceSubnets:
  - ${service_cidr}
---
# OpenEBS LocalPV's base path (flux/infrastructure/controllers/values/
# openebs-localpv.yaml): a directory on the EPHEMERAL partition, mounted at
# /var/mnt/local-storage, where the kubelet can reach it.
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-storage
volumeType: directory
