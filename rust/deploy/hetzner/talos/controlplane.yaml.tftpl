# Control-plane nodes: the API answers on the load balancer's addresses, etcd
# peers over the private network, and no workloads run here unless the
# cluster has no workers (a small test cluster, worker_count = 0).
machine:
  certSANs:
%{ for san in cert_sans ~}
    - ${san}
%{ endfor ~}
cluster:
  apiServer:
    certSANs:
%{ for san in cert_sans ~}
      - ${san}
%{ endfor ~}
  etcd:
    advertisedSubnets:
      - ${nodes_subnet}
  allowSchedulingOnControlPlanes: ${allow_scheduling}
