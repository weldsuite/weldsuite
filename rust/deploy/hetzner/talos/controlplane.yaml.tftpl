# Control-plane nodes: the API answers on the load balancer's addresses, etcd
# peers over the private network, and no workloads run here unless the
# cluster has no workers (a small test cluster, worker_count = 0). The API
# server's names are in KubeAPIServerConfig in Talos 1.14 (common.yaml.tftpl).
machine:
  certSANs:
%{ for san in cert_sans ~}
    - ${san}
%{ endfor ~}
cluster:
  etcd:
    advertisedSubnets:
      - ${nodes_subnet}
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
certExtraSANs:
%{ for san in cert_sans ~}
  - ${san}
%{ endfor ~}
---
# Flannel tunnels pod traffic between nodes over the private network. Left
# alone it picks the interface of the default route, the public one, where the
# Hetzner firewall drops the VXLAN packets: pods on different nodes can't reach
# each other (the ingress load balancer's health checks fail first). The
# control plane renders the flannel manifest, so this only goes here.
apiVersion: v1alpha1
kind: KubeFlannelCNIConfig
extraArgs:
  - --iface-can-reach=${private_gateway}
%{ if allow_scheduling ~}
---
# Workloads on the control plane: drop the taint the generated config sets.
apiVersion: v1alpha1
kind: KubeNodeConfig
taints:
  node-role.kubernetes.io/control-plane:
    $patch: delete
%{ endif ~}
