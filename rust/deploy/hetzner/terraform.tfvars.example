# Copy to terraform.tfvars (git-ignored) or pass with -var / TF_VAR_*.
# hcloud_token is best set as TF_VAR_hcloud_token, never written to a file.

cluster_name = "weldsuite-eu"
domain       = "eu.example.org"

# Operators and the drill runner only.
admin_cidrs = ["203.0.113.10/32"]

# api_hostname = "k8s.eu.example.org"

# Defaults: three control-plane nodes (fsn1, nbg1, hel1), three general
# workers over fsn1 + nbg1, two Postgres nodes (fsn1, nbg1).
# worker_count  = 3
# worker_type   = "cpx32"
# postgres_type = "ccx23"

# The MTA's mail nodes (README.md, "Mail"): one per pool to start, each with
# its own primary IPv4 and reverse DNS mail<n>-<pool>.<domain>. Leave it out
# for none. Request the outbound port 25 unblock from Hetzner first.
mail_pools = {
  system   = { count = 1, type = "cpx22", locations = ["fsn1"] }
  customer = { count = 1, type = "cpx22", locations = ["nbg1"] }
}

# WeldMail's MX (Haraka) on port 25 of the ingress load balancer, to this
# NodePort (mailInbound in flux/apps/eu/values/weldsuite.yaml uses the same).
mx_node_port = 30025
