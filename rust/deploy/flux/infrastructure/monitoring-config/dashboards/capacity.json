{
  "uid": "weldsuite-capacity",
  "title": "WeldSuite capacity",
  "description": "Room left per node: what the pods ask for (requests) and use, against what each node has. For deciding when another node is due.",
  "tags": [
    "weldsuite"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
