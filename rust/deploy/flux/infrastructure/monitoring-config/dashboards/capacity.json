      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"cpu\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"cpu\"} * on (namespace, pod) group_left () (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "sum by (node) (label_replace(sum by (instance) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m])) * on (instance) group_left (nodename) node_uname_info, \"node\", \"$1\", \"nodename\", \"(.*)\"))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"memory\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"memory\"} * on (namespace, pod) group_left () (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "F",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "sum by (node) (label_replace((node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) * on (instance) group_left (nodename) node_uname_info, \"node\", \"$1\", \"nodename\", \"(.*)\"))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "G",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "count by (node) (kube_pod_info{node!=\"\"} * on (namespace, pod) group_left () (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "H",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"pods\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "I",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "max by (node) (label_replace(max by (instance, device) (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs|squashfs|overlay|nsfs|rootfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs|squashfs|overlay|nsfs|rootfs\"}) * on (instance) group_left (nodename) node_uname_info, \"node\", \"$1\", \"nodename\", \"(.*)\"))"
        }
      ],
      "description": "CPU in cores. Requested: what the scheduler has promised the running pods; a node full of requests takes no more pods, however idle.",
