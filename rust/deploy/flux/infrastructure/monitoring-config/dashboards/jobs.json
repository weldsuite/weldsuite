          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "sum by (weldsuite_job) (rate(weldsuite_job_runs_total{outcome=\"error\"}[$__rate_interval])) / clamp_min(sum by (weldsuite_job) (rate(weldsuite_job_runs_total[$__rate_interval])), 1e-9)",
          "legendFormat": "{{weldsuite_job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
