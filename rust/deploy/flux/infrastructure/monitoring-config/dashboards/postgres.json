{
  "uid": "weldsuite-postgres",
  "title": "WeldSuite Postgres and backups",
  "description": "The CloudNativePG clusters as the alerts see them: instances, backups, WAL archiving, connections, replication, size. Detail: the CloudNativePG dashboard (Components).",
  "tags": [
    "weldsuite"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "WeldSuite",
      "type": "dashboards",
      "tags": [
        "weldsuite"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cnpg_cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(cnpg_collector_up, cnpg_cluster)",
          "refId": "cnpg_cluster"
        },
        "definition": "label_values(cnpg_collector_up, cnpg_cluster)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Clusters",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Clusters now",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 24,
        "h": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "sum by (cnpg_cluster) (label_replace((kube_pod_status_ready{namespace=~\"postgres|zitadel\", pod!~\".*-pooler-.*\", condition=\"true\"} == 1) * on (namespace, pod) group_left (label_cnpg_io_cluster) (kube_pod_labels{namespace=~\"postgres|zitadel\", pod!~\".*-pooler-.*\", label_cnpg_io_cluster!=\"\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)), \"cnpg_cluster\", \"$1\", \"label_cnpg_io_cluster\", \"(.*)\"))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "count by (cnpg_cluster) (label_replace((kube_pod_labels{namespace=~\"postgres|zitadel\", pod!~\".*-pooler-.*\", label_cnpg_io_cluster!=\"\"} unless on (namespace, pod) (kube_pod_status_phase{phase=~\"Succeeded|Failed\"} == 1)), \"cnpg_cluster\", \"$1\", \"label_cnpg_io_cluster\", \"(.*)\"))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "time() - max by (cnpg_cluster) ((barman_cloud_cloudnative_pg_io_last_available_backup_timestamp or cnpg_collector_last_available_backup_timestamp))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "min by (cnpg_cluster) (cnpg_pg_stat_archiver_seconds_since_last_archival and on (namespace, pod) (cnpg_pg_replication_in_recovery == 0))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "max by (cnpg_cluster) (cnpg_pg_stat_archiver_last_failed_time > bool cnpg_pg_stat_archiver_last_archived_time)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "F",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "max by (cnpg_cluster) (sum by (cnpg_cluster, pod) (cnpg_backends_total) / on (cnpg_cluster, pod) max by (cnpg_cluster, pod) (cnpg_pg_settings_setting{name=\"max_connections\"}))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "G",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table",
          "expr": "sum by (cnpg_cluster) (max by (cnpg_cluster, datname) (cnpg_pg_database_size_bytes{datname!~\"template.*|postgres\"}))"
        }
      ],
      "description": "Last backup: age of the newest base backup (nightly). Last WAL archived: on the primary, with any writes at least every 5 minutes.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "endpoint": true,
              "service": true,
              "pod": true,
              "container": true,
              "namespace": true,
              "prometheus": true,
              "cluster": true,
              "uid": true
            },
            "renameByName": {
              "Value #A": "Ready",
              "Value #B": "Instances",
              "Value #C": "Last backup",
              "Value #D": "Last WAL archived",
              "Value #E": "Archiving failing",
              "Value #F": "Connections used",
              "Value #G": "Size"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Instances"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last backup"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "value": 93600,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last WAL archived"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "value": 3600,
                      "color": "orange"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Archiving failing"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "value": 1,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Connections used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "value": 0.8,
                      "color": "orange"
                    },
                    {
                      "value": 0.95,
                      "color": "red"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Size"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [],
        "cellHeight": "sm"
      }
    },
