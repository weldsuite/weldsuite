                "score": 1
              },
              {
                "id": "c_q2_nine",
                "label": "9",
                "score": 0
              }
            ],
            "multiple": false,
            "randomize": false
          },
          "ref": "planet_count",
          "required": true,
          "title": "How many planets are in the solar system?",
          "type": "multiple_choice"
        },
        {
          "id": "b_q3",
          "properties": {
            "allowOther": false,
            "choices": [
              {
                "id": "c_q3_jupiter",
                "label": "Jupiter",
                "score": 0
              },
              {
                "correct": true,
                "id": "c_q3_mars",
                "label": "Mars",
                "score": 1
              },
              {
                "id": "c_q3_saturn",
                "label": "Saturn",
                "score": 0
              }
            ],
            "multiple": false,
            "randomize": false
          },
          "ref": "red_planet",
          "required": true,
          "title": "Which planet is known as the Red Planet?",
          "type": "multiple_choice"
        }
      ],
      "endingRules": [
        {
          "endingId": "e_perfect",
          "id": "j_perfect",
          "when": {
            "conditions": [
              {
                "left": {
                  "name": "score",
                  "type": "variable"
                },
                "operator": "greater_or_equal",
                "right": {
                  "type": "constant",
                  "value": 3
                }
              }
            ],
            "op": "and"
          }
        },
        {
          "endingId": "e_good",
          "id": "j_good",
          "when": {
            "conditions": [
              {
                "left": {
                  "name": "score",
                  "type": "variable"
                },
                "operator": "greater_or_equal",
                "right": {
                  "type": "constant",
                  "value": 1
                }
              }
            ],
            "op": "and"
          }
        },
        {
          "endingId": "e_try_again",
          "id": "j_try_again",
          "when": {
            "conditions": [
              {
                "left": {
                  "name": "score",
                  "type": "variable"
                },
                "operator": "less_than",
                "right": {
                  "type": "constant",
                  "value": 1
                }
              }
            ],
            "op": "and"
          }
        }
      ],
      "endings": [
        {
          "description": "You got {{var:score}} out of 3.",
          "id": "e_perfect",
          "ref": "perfect",
          "showAnswers": true,
          "showScore": true,
          "title": "Perfect!"
        },
        {
          "description": "You got {{var:score}} out of 3.",
          "id": "e_good",
          "ref": "good_effort",
          "showAnswers": true,
          "showScore": true,
          "title": "Good effort!"
        },
        {
          "description": "You got {{var:score}} out of 3. Have another go!",
          "id": "e_try_again",
          "ref": "try_again",
          "showAnswers": true,
          "showScore": true,
          "title": "Try again"
        }
      ],
      "hidden": [],
      "logic": [],
      "presentation": {
        "allowBack": true,
        "language": "en",
        "layout": "conversational",
        "progressBar": "percentage",
        "showQuestionNumbers": true
      },
      "schemaVersion": 1,
      "variables": [],
      "welcome": {
        "buttonText": "Start the quiz",
        "title": "How well do you know the solar system?"
      }
