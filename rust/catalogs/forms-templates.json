  {
    "category": "feedback",
    "definition": {
      "blocks": [
        {
          "id": "b_nps",
          "properties": {
            "labels": {
              "left": "Not likely",
              "right": "Very likely"
            }
          },
          "ref": "recommend",
          "required": true,
          "title": "How likely are you to recommend us to a friend or colleague?",
          "type": "nps"
        },
        {
          "id": "b_liked",
          "properties": {},
          "ref": "what_went_well",
          "required": false,
          "title": "Great to hear! What do you like most about us?",
          "type": "long_text"
        },
        {
          "id": "b_wrong",
          "properties": {},
          "ref": "what_went_wrong",
          "required": true,
          "title": "Sorry to hear that. What went wrong?",
          "type": "long_text"
        },
        {
          "id": "b_follow_up",
          "properties": {},
          "ref": "follow_up",
          "required": true,
          "title": "May we contact you about your answers?",
          "type": "yes_no"
        },
        {
          "id": "b_email",
          "properties": {},
          "ref": "email",
          "required": true,
          "title": "What is your email address?",
          "type": "email"
        }
      ],
      "endingRules": [],
      "endings": [
        {
          "id": "e_thanks",
          "ref": "thank_you",
          "showAnswers": false,
          "showScore": false,
          "title": "Thank you for your feedback!"
        }
      ],
      "hidden": [],
      "logic": [
        {
          "blockId": "b_nps",
          "calculations": [],
          "jumps": [
            {
              "id": "j_detractor",
              "to": {
                "id": "b_wrong",
                "type": "block"
              },
              "when": {
                "conditions": [
                  {
                    "left": {
                      "id": "b_nps",
                      "type": "field"
                    },
                    "operator": "less_or_equal",
                    "right": {
                      "type": "constant",
                      "value": 6
                    }
                  }
                ],
                "op": "and"
              }
            }
          ],
          "otherwise": null
        },
        {
          "blockId": "b_liked",
          "calculations": [],
          "jumps": [],
          "otherwise": {
            "id": "b_follow_up",
            "type": "block"
          }
        },
        {
          "blockId": "b_follow_up",
          "calculations": [],
          "jumps": [
            {
              "id": "j_no_contact",
              "to": {
                "id": "e_thanks",
                "type": "ending"
              },
              "when": {
                "conditions": [
                  {
                    "left": {
                      "id": "b_follow_up",
                      "type": "field"
                    },
                    "operator": "is",
                    "right": {
                      "type": "constant",
                      "value": false
                    }
                  }
                ],
                "op": "and"
              }
            }
          ],
          "otherwise": null
        }
      ],
      "presentation": {
        "allowBack": true,
        "language": "en",
        "layout": "conversational",
        "progressBar": "percentage",
        "showQuestionNumbers": true
      },
      "schemaVersion": 1,
      "variables": [],
      "welcome": {
        "buttonText": "Start",
        "description": "A few quick questions, it takes about a minute.",
        "title": "Tell us how we did"
      }
    },
    "description": {
      "en": "Measure your Net Promoter Score and ask unhappy customers what went wrong.",
      "nl": "Meet je Net Promoter Score en vraag ontevreden klanten wat er misging."
    },
    "id": "customer-feedback",
    "name": {
      "en": "Customer feedback (NPS)",
      "nl": "Klanttevredenheid (NPS)"
    }
  },
