/**
 * Generates rust/crates/books-domain/src/tables.rs: the tenant tables
 * books-api reads and writes, as Drizzle sees them (property → column, kind;
 * every column checked against the latest tenant snapshot), each with its
 * SeaORM entity, whose statements read a row the way Drizzle returns it and
 * write a `{ column: value }` JSON object the way Drizzle's insert/update
 * would (`weldsuite_db::record`): a column the object leaves out gets its
 * database default (insert) or keeps its value (patch), one it sets to null
 * gets NULL.
 *
 * Every table of the `accounting-*.ts` schema files, plus the few other tables
 * books touches (EXTRA).
 *
 *   pnpm --filter @weldsuite/db exec tsx ../../../rust/crates/books-domain/tools/tables.mts
 *
 * Run from packages/core/db (it imports the Drizzle schema). Commit the output.
 */

import { readFileSync, readdirSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { getTableColumns, getTableName, is } from 'drizzle-orm';
import { PgTable } from 'drizzle-orm/pg-core';
import * as schema from '@weldsuite/db/schema';

const here = path.dirname(fileURLToPath(import.meta.url));
const repo = path.resolve(here, '../../../..');
const schemaDir = path.join(repo, 'packages/core/db/src/schema');
const snapshotDir = path.join(repo, 'rust/migrations/tenant/meta');
const latest = readdirSync(snapshotDir)
  .filter((f) => f.endsWith('_snapshot.json'))
  .sort((a, b) => Number.parseInt(a, 10) - Number.parseInt(b, 10))
  .at(-1)!;
const snapshot = JSON.parse(readFileSync(path.join(snapshotDir, latest), 'utf8')) as {
  tables: Record<string, { columns: Record<string, { type: string; default?: unknown }> }>;
};

/**
 * Tables outside the accounting-*.ts files that books reads or writes. The
 * legal entity (`entities`), its registrations and its bank accounts are core
 * (legal-entities.ts); WeldBooks' extensions of them are accounting files.
 */
const EXTRA = [
  'legalEntities',
  'legalEntityRegistrations',
  'bankAccounts',
  'parties',
  'companies',
  'people',
  'personCompanies',
  'products',
  'orders',
  'orderItems',
  'notifications',
  'workspaceMembers',
  'workflowTemplates',
];

const fromAccountingFiles = readdirSync(schemaDir)
  .filter((f) => f.startsWith('accounting-') && f.endsWith('.ts') && !f.endsWith('.test.ts'))
  .sort()
  .flatMap((f) => [...readFileSync(path.join(schemaDir, f), 'utf8').matchAll(/export const (\w+) = pgTable\(/g)].map((m) => m[1]));
const TABLES = [...new Set([...fromAccountingFiles, ...EXTRA])];

type Kind = 'Text' | 'Number' | 'Bool' | 'Json' | 'Date' | 'DateString' | 'Numeric' | 'Array' | 'Other';

function kindOf(columnType: string): Kind {
  switch (columnType) {
    case 'PgText':
    case 'PgVarchar':
    case 'PgChar':
    case 'PgUUID':
    case 'PgEnumColumn':
      return 'Text';
    case 'PgInteger':
    case 'PgSmallInt':
    case 'PgSerial':
    case 'PgBigInt53':
    case 'PgDoublePrecision':
    case 'PgReal':
      return 'Number';
    case 'PgBoolean':
      return 'Bool';
    case 'PgJsonb':
    case 'PgJson':
      return 'Json';
    case 'PgTimestamp':
    case 'PgDate':
      return 'Date';
    case 'PgTimestampString':
    case 'PgDateString':
      return 'DateString';
    case 'PgNumeric':
      return 'Numeric';
    case 'PgArray':
      return 'Array';
    default:
      return 'Other';
  }
}

const quote = (name: string) => `"${name.replaceAll('"', '""')}"`;

let out = `//! Generated by \`tools/tables.mts\` from the Drizzle schema and tenant
//! snapshot ${latest}; don't edit. The tables books-api reads and writes:
//! Drizzle's properties and kinds, and the entity whose statements read a row
//! as Drizzle returns it and write a \`{ column: value }\` object as Drizzle
//! would (see [\`crate::table\`]).

#![allow(clippy::doc_markdown, dead_code)]

use weldsuite_db::record::JsonTable;
use weldsuite_schema::tenant;

use crate::table::{Column, Kind, Table};
`;

for (const exportName of TABLES) {
  const table = (schema as Record<string, unknown>)[exportName];
  if (!is(table, PgTable)) throw new Error(`${exportName} is not a table`);
  const name = getTableName(table);
  const snap = snapshot.tables[`public.${name}`];
  if (!snap) throw new Error(`${name} is not in ${latest}`);
  const columns = Object.entries(getTableColumns(table)).map(([prop, column]) => {
    const c = column as unknown as { name: string; columnType: string; defaultFn?: unknown };
    const s = snap.columns[c.name];
    if (!s) throw new Error(`${name}.${c.name} is not in ${latest}`);
    return { prop, name: c.name, kind: kindOf(c.columnType), defaultFn: !!c.defaultFn };
  });
  const constName = name.toUpperCase();
  out += `
/// \`${exportName}\` (\`${name}\`).
pub const ${constName}: Table = Table {
    name: "${name}",
    entity: JsonTable::of::<tenant::${name}::Entity>(),
    columns: &[
${columns.map((c) => `        Column { prop: "${c.prop}", name: "${c.name}", kind: Kind::${c.kind}, default_fn: ${c.defaultFn} },`).join('\n')}
    ],
};
`;
}

// The row expressions as literals, for statements built with `concat!` (sqlx
// takes only literal SQL): `concat!("select ", books_row!(accounts), " from accounts t where …")`.
out += `
/// The row expression of a table (aliased \`t\`) as a literal: \`to_jsonb(t)\`
/// with \`numeric\` columns as text. Use it in \`concat!\` to select rows that
/// [\`Table::js\`] turns into Drizzle's shape.
#[macro_export]
macro_rules! books_row {
${TABLES.map((exportName) => {
  const table = (schema as Record<string, unknown>)[exportName] as PgTable;
  const name = getTableName(table);
  const numeric = Object.values(getTableColumns(table)).filter((c) => kindOf((c as unknown as { columnType: string }).columnType) === 'Numeric') as unknown as Array<{ name: string }>;
  const row = numeric.length
    ? `(to_jsonb(t) || jsonb_build_object(${numeric.map((c) => `'${c.name}', t.${quote(c.name)}::text`).join(', ')}))`
    : 'to_jsonb(t)';
  return `    (${name}) => {\n        ${JSON.stringify(row)}\n    };`;
}).join('\n')}
}
`;

writeFileSync(path.join(here, '../src/tables.rs'), out);
console.log(`wrote ${TABLES.length} tables from ${latest}`);
