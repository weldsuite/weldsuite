/**
 * Generates rust/crates/commerce-domain/src/tables.rs: the tenant tables the
 * order writes touch (orders, their items, discounts and redemptions, the
 * commerce settings), as Drizzle sees them, each with its SeaORM entity
 * (`weldsuite_books_domain::table`; the generator is books-domain's
 * tools/tables.mts over another list of tables). Columns with a Drizzle
 * `$onUpdate` are listed in a comment: an update that leaves them out gets them
 * from Drizzle, so ingest sets them itself.
 *
 *   pnpm --filter @weldsuite/db exec tsx ../../../rust/crates/commerce-domain/tools/tables.mts
 *
 * Run from packages/core/db (it imports the Drizzle schema). Commit the output.
 */

import { readFileSync, readdirSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { getTableColumns, getTableName, is } from 'drizzle-orm';
import { PgTable } from 'drizzle-orm/pg-core';
import * as schema from '@weldsuite/db/schema';

const here = path.dirname(fileURLToPath(import.meta.url));
const repo = path.resolve(here, '../../../..');
const schemaDir = path.join(repo, 'packages/core/db/src/schema');
const snapshotDir = path.join(repo, 'rust/migrations/tenant/meta');
const latest = readdirSync(snapshotDir)
  .filter((f) => f.endsWith('_snapshot.json'))
  .sort((a, b) => Number.parseInt(a, 10) - Number.parseInt(b, 10))
  .at(-1)!;
const snapshot = JSON.parse(readFileSync(path.join(snapshotDir, latest), 'utf8')) as {
  tables: Record<string, { columns: Record<string, { type: string; default?: unknown }> }>;
};

const TABLES = [
  'orders',
  'orderItems',
  'discounts',
  'discountRedemptions',
  'commerceSettings',
];

type Kind = 'Text' | 'Number' | 'Bool' | 'Json' | 'Date' | 'DateString' | 'Numeric' | 'Array' | 'Other';

function kindOf(columnType: string): Kind {
  switch (columnType) {
    case 'PgText':
    case 'PgVarchar':
    case 'PgChar':
    case 'PgUUID':
    case 'PgEnumColumn':
      return 'Text';
    case 'PgInteger':
    case 'PgSmallInt':
    case 'PgSerial':
    case 'PgBigInt53':
    case 'PgDoublePrecision':
    case 'PgReal':
      return 'Number';
    case 'PgBoolean':
      return 'Bool';
    case 'PgJsonb':
    case 'PgJson':
      return 'Json';
    case 'PgTimestamp':
    case 'PgDate':
      return 'Date';
    case 'PgTimestampString':
    case 'PgDateString':
      return 'DateString';
    case 'PgNumeric':
      return 'Numeric';
    case 'PgArray':
      return 'Array';
    default:
      return 'Other';
  }
}

let out = `//! Generated by \`tools/tables.mts\` from the Drizzle schema and tenant
//! snapshot ${latest}; don't edit. The tables the order writes touch:
//! Drizzle's properties and kinds, and the entity whose statements read a row
//! as Drizzle returns it and write a \`{ column: value }\` object as Drizzle
//! would (see [\`weldsuite_books_domain::table\`]).

#![allow(clippy::doc_markdown, dead_code)]

use weldsuite_books_domain::table::{Column, Kind, Table};
use weldsuite_db::record::JsonTable;
use weldsuite_schema::tenant;
`;

for (const exportName of TABLES) {
  const table = (schema as Record<string, unknown>)[exportName];
  if (!is(table, PgTable)) throw new Error(`${exportName} is not a table`);
  const name = getTableName(table);
  const snap = snapshot.tables[`public.${name}`];
  if (!snap) throw new Error(`${name} is not in ${latest}`);
  const columns = Object.entries(getTableColumns(table)).map(([prop, column]) => {
    const c = column as unknown as { name: string; columnType: string; defaultFn?: unknown; onUpdateFn?: unknown };
    const s = snap.columns[c.name];
    if (!s) throw new Error(`${name}.${c.name} is not in ${latest}`);
    return { prop, name: c.name, kind: kindOf(c.columnType), defaultFn: !!c.defaultFn, onUpdate: !!c.onUpdateFn };
  });
  const constName = name.toUpperCase();
  const onUpdate = columns.filter((c) => c.onUpdate).map((c) => c.prop);
  const defaultFns = columns.filter((c) => c.defaultFn).map((c) => c.prop);
  const notes = [
    onUpdate.length ? `\n/// Drizzle \`$onUpdate\`: ${onUpdate.join(', ')}.` : '',
    defaultFns.length ? `\n/// Drizzle \`$defaultFn\`: ${defaultFns.join(', ')}.` : '',
  ].join('');
  out += `
/// \`${exportName}\` (\`${name}\`).${notes}
pub const ${constName}: Table = Table {
    name: "${name}",
    entity: JsonTable::of::<tenant::${name}::Entity>(),
    columns: &[
${columns.map((c) => `        Column { prop: "${c.prop}", name: "${c.name}", kind: Kind::${c.kind}, default_fn: ${c.defaultFn} },`).join('\n')}
    ],
};
`;
}

writeFileSync(path.join(here, '../src/tables.rs'), out);
console.log(`wrote ${TABLES.length} tables from ${latest}`);
