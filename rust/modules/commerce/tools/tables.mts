/**
 * Generates rust/modules/commerce/src/tables.rs: the tenant tables of the
 * catalogue (products, their variants, categories and the manual category
 * members), of the order book (orders and their items, discounts and their
 * redemptions, the commerce settings) and of the storefront, as Drizzle sees
 * them (property → column, kind), each with its SeaORM entity, whose
 * statements write a `{ column: value }` JSON object the way Drizzle's would
 * (`weldsuite_db::record`): a column the object leaves out gets its database
 * default (insert) or keeps its value (patch), one it sets to null gets NULL.
 *
 *   pnpm --filter @weldsuite/db exec tsx ../../../rust/modules/commerce/tools/tables.mts
 *
 * Run from packages/core/db (it imports the Drizzle schema). Commit the output.
 * The same generator as rust/modules/stash/tools/tables.mts, whose products
 * route moved here: a patch may also set `id` (Drizzle's `.set({ id })`
 * renames the row; the products schema is a passthrough that lets an `id`
 * through, and the stash conformance suite checks that), which `crate::table`
 * handles.
 */

import { writeFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { getTableColumns, getTableName, is } from 'drizzle-orm';
import { PgTable } from 'drizzle-orm/pg-core';
import * as schema from '@weldsuite/db/schema';

const here = path.dirname(fileURLToPath(import.meta.url));

/** The tables, by their export name in @weldsuite/db/schema. */
const TABLES = [
  'products',
  'productVariants',
  'categories',
  'categoryProducts',
  // Phase 2: orders, discount codes and the numbering settings.
  'orders',
  'orderItems',
  'discounts',
  'discountRedemptions',
  'commerceSettings',
  // Phase 4: channels, shipping rates, storefront keys, prices and carts.
  'commerceChannels',
  'commerceShippingRates',
  'commerceChannelKeys',
  'productPrices',
  'carts',
  'cartItems',
  // Phase 5: payments, refunds and the payment provider connection.
  'commercePayments',
  'commerceRefunds',
  'commercePaymentConnections',
  // Phase 6: B2B buyers, per-company settings and order approvals.
  'commerceBuyers',
  'commerceCompanySettings',
  'orderApprovals',
] as const;

type Kind = 'Text' | 'Number' | 'Bool' | 'Json' | 'Date' | 'DateString' | 'Numeric' | 'Array' | 'Other';

function kindOf(columnType: string): Kind {
  switch (columnType) {
    case 'PgText':
    case 'PgVarchar':
    case 'PgChar':
    case 'PgUUID':
    case 'PgEnumColumn':
      return 'Text';
    case 'PgInteger':
    case 'PgSmallInt':
    case 'PgSerial':
    case 'PgBigInt53':
    case 'PgDoublePrecision':
    case 'PgReal':
      return 'Number';
    case 'PgBoolean':
      return 'Bool';
    case 'PgJsonb':
    case 'PgJson':
      return 'Json';
    case 'PgTimestamp':
    case 'PgDate':
      return 'Date';
    case 'PgTimestampString':
    case 'PgDateString':
      return 'DateString';
    case 'PgNumeric':
      return 'Numeric';
    case 'PgArray':
      return 'Array';
    default:
      return 'Other';
  }
}

let out = `//! Generated by \`tools/tables.mts\` from the Drizzle schema; don't edit. The
//! catalogue's and the order book's tables: Drizzle's properties and kinds,
//! and the entity whose statements write a \`{ column: value }\` object as
//! Drizzle would (see [\`crate::table\`]).

#![allow(clippy::doc_markdown, dead_code)]

use crate::table::{Column, Kind, Table};
use weldsuite_db::record::JsonTable;
use weldsuite_schema::tenant;
`;

const constNames: string[] = [];
for (const exportName of TABLES) {
  const table = (schema as Record<string, unknown>)[exportName];
  if (!is(table, PgTable)) throw new Error(`${exportName} is not a table`);
  const name = getTableName(table);
  const columns = Object.entries(getTableColumns(table)).map(([prop, column]) => {
    const c = column as unknown as { name: string; columnType: string; defaultFn?: unknown };
    return { prop, name: c.name, kind: kindOf(c.columnType), defaultFn: !!c.defaultFn };
  });
  const constName = name.toUpperCase();
  constNames.push(constName);
  out += `
/// \`${exportName}\` (\`${name}\`).
pub(crate) const ${constName}: Table = Table {
    name: "${name}",
    entity: JsonTable::of::<tenant::${name}::Entity>(),
    columns: &[
${columns.map((c) => `        Column { prop: "${c.prop}", name: "${c.name}", kind: Kind::${c.kind}${c.defaultFn ? ', default_fn: true' : ', default_fn: false'} },`).join('\n')}
    ],
};
`;
}

out += `
/// Every table above, for the test that holds each to its entity.
pub(crate) const ALL: &[&Table] = &[
${constNames.map((n) => `    &${n},`).join('\n')}
];
`;

writeFileSync(path.join(here, '../src/tables.rs'), out);
console.log(`wrote ${TABLES.length} tables`);
