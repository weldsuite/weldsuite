/**
 * Generates rust/modules/stash/src/tables.rs: the tenant tables stash-api
 * writes with `db.insert(t).values({ id, ...data })` / `db.update(t).set(data)`
 * (and the rows it builds itself), as Drizzle sees them (property → column,
 * kind), each with its SeaORM entity, whose statements write a
 * `{ column: value }` JSON object the way Drizzle's would
 * (`weldsuite_db::record`): a column the object leaves out gets its database
 * default (insert) or keeps its value (patch), one it sets to null gets NULL.
 *
 *   pnpm --filter @weldsuite/db exec tsx ../../../rust/modules/stash/tools/tables.mts
 *
 * Run from packages/core/db (it imports the Drizzle schema). Commit the output.
 * The same generator as rust/modules/desk/tools/tables.mts; a patch may also
 * set `id` (Drizzle's `.set({ id })` renames the row; the passthrough schemas
 * let an `id` through), which `crate::table` handles.
 */

import { writeFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { getTableColumns, getTableName, is } from 'drizzle-orm';
import { PgTable } from 'drizzle-orm/pg-core';
import * as schema from '@weldsuite/db/schema';

const here = path.dirname(fileURLToPath(import.meta.url));

/** The tables, by their export name in @weldsuite/db/schema. */
const TABLES = [
  'boxes',
  'warehouses',
  'cycleCounts',
  'purchaseOrders',
  'purchaseOrderItems',
  'inventoryMovements',
  'warehouseZones',
  'warehouseLocations',
  'suppliers',
  'warehouseWorkers',
  'stockAdjustments',
  'inventory',
  'pickLists',
  'pickListItems',
  'activityLogs',
  'parcels',
  'shipments',
  'orders',
] as const;

type Kind = 'Text' | 'Number' | 'Bool' | 'Json' | 'Date' | 'DateString' | 'Numeric' | 'Array' | 'Other';

function kindOf(columnType: string): Kind {
  switch (columnType) {
    case 'PgText':
    case 'PgVarchar':
    case 'PgChar':
    case 'PgUUID':
    case 'PgEnumColumn':
      return 'Text';
    case 'PgInteger':
    case 'PgSmallInt':
    case 'PgSerial':
    case 'PgBigInt53':
    case 'PgDoublePrecision':
    case 'PgReal':
      return 'Number';
    case 'PgBoolean':
      return 'Bool';
    case 'PgJsonb':
    case 'PgJson':
      return 'Json';
    case 'PgTimestamp':
    case 'PgDate':
      return 'Date';
    case 'PgTimestampString':
    case 'PgDateString':
      return 'DateString';
    case 'PgNumeric':
      return 'Numeric';
    case 'PgArray':
      return 'Array';
    default:
      return 'Other';
  }
}

/**
 * Columns the SeaORM entities gained after the Drizzle schema froze
 * (DATA-019): Drizzle doesn't know them, so they are listed here, by table, in
 * the entity's order. They go into `entity_only`, not `columns`: the routes
 * answer as stash-api does, which never reads or writes them.
 */
const ENTITY_ONLY: Record<string, { prop: string; name: string; kind: Kind }[]> = {
  parcels: [
    { prop: 'pickListId', name: 'pick_list_id', kind: 'Text' },
    { prop: 'carrierCode', name: 'carrier_code', kind: 'Text' },
    { prop: 'carrierReference', name: 'carrier_reference', kind: 'Text' },
    { prop: 'trackingUrl', name: 'tracking_url', kind: 'Text' },
    { prop: 'colloNumber', name: 'collo_number', kind: 'Number' },
    { prop: 'servicePoint', name: 'service_point', kind: 'Json' },
    { prop: 'returnForParcelId', name: 'return_for_parcel_id', kind: 'Text' },
    { prop: 'trackingNextCheckAt', name: 'tracking_next_check_at', kind: 'Date' },
  ],
};

let out = `//! Generated by \`tools/tables.mts\` from the Drizzle schema; don't edit. The
//! tables stash-api writes: Drizzle's properties and kinds, and the entity
//! whose statements write a \`{ column: value }\` object as Drizzle would (see
//! [\`crate::table\`]).

#![allow(clippy::doc_markdown, dead_code)]

use crate::table::{Column, Kind, Table};
use weldsuite_db::record::JsonTable;
use weldsuite_schema::tenant;
`;

const constNames: string[] = [];
for (const exportName of TABLES) {
  const table = (schema as Record<string, unknown>)[exportName];
  if (!is(table, PgTable)) throw new Error(`${exportName} is not a table`);
  const name = getTableName(table);
  const columns = Object.entries(getTableColumns(table)).map(([prop, column]) => {
    const c = column as unknown as { name: string; columnType: string; defaultFn?: unknown };
    return { prop, name: c.name, kind: kindOf(c.columnType), defaultFn: !!c.defaultFn };
  });
  const entityOnly = (ENTITY_ONLY[name] ?? []).map(
    (c) => `        Column { prop: "${c.prop}", name: "${c.name}", kind: Kind::${c.kind}, default_fn: false },`,
  );
  const constName = name.toUpperCase();
  constNames.push(constName);
  out += `
/// \`${exportName}\` (\`${name}\`).
pub(crate) const ${constName}: Table = Table {
    name: "${name}",
    entity: JsonTable::of::<tenant::${name}::Entity>(),
    columns: &[
${columns.map((c) => `        Column { prop: "${c.prop}", name: "${c.name}", kind: Kind::${c.kind}${c.defaultFn ? ', default_fn: true' : ', default_fn: false'} },`).join('\n')}
    ],
    entity_only: &[${entityOnly.length ? `\n${entityOnly.join('\n')}\n    ` : ''}],
};
`;
}

out += `
/// Every table above, for the test that holds each to its entity.
pub(crate) const ALL: &[&Table] = &[
${constNames.map((n) => `    &${n},`).join('\n')}
];
`;

writeFileSync(path.join(here, '../src/tables.rs'), out);
console.log(`wrote ${TABLES.length} tables`);
