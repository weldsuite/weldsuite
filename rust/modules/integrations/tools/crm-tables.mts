/**
 * Generates rust/modules/integrations/src/crm/tables.rs: the tenant tables the
 * CRM sync engine writes generically (integration-webhook-worker's
 * `upsertByMapping`, `db.insert(table).values({ id, ...values })` and
 * `db.update(table).set(values)` for whatever the field mappings produced),
 * as Drizzle sees them (property → column, kind) with the database defaults
 * of the latest tenant snapshot. Same model and statements as
 * rust/crates/books-domain/tools/tables.mts (`weldsuite_books_domain::table`).
 *
 *   pnpm --filter @weldsuite/db exec tsx ../../../rust/modules/integrations/tools/crm-tables.mts
 *
 * Run from packages/core/db (it imports the Drizzle schema). Commit the output.
 */

import { readFileSync, readdirSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { getTableColumns, getTableName, is } from 'drizzle-orm';
import { PgTable } from 'drizzle-orm/pg-core';
import * as schema from '@weldsuite/db/schema';

const here = path.dirname(fileURLToPath(import.meta.url));
const repo = path.resolve(here, '../../../..');
const snapshotDir = path.join(repo, 'packages/core/db/drizzle/tenant-migrations/meta');
const latest = readdirSync(snapshotDir)
  .filter((f) => f.endsWith('_snapshot.json'))
  .sort((a, b) => Number.parseInt(a, 10) - Number.parseInt(b, 10))
  .at(-1)!;
const snapshot = JSON.parse(readFileSync(path.join(snapshotDir, latest), 'utf8')) as {
  tables: Record<string, { columns: Record<string, { type: string; default?: unknown }> }>;
};

/** `getEntityTable(entityType)` in lib/engine/sync/orchestrator.ts, in its order. */
const TABLES = ['companies', 'people', 'crmLeads', 'crmOpportunities', 'crmActivities', 'calendarEvents', 'crmPipelines'];

type Kind = 'Text' | 'Number' | 'Bool' | 'Json' | 'Date' | 'DateString' | 'Numeric' | 'Array' | 'Other';

function kindOf(columnType: string): Kind {
  switch (columnType) {
    case 'PgText':
    case 'PgVarchar':
    case 'PgChar':
    case 'PgUUID':
    case 'PgEnumColumn':
      return 'Text';
    case 'PgInteger':
    case 'PgSmallInt':
    case 'PgSerial':
    case 'PgBigInt53':
    case 'PgDoublePrecision':
    case 'PgReal':
      return 'Number';
    case 'PgBoolean':
      return 'Bool';
    case 'PgJsonb':
    case 'PgJson':
      return 'Json';
    case 'PgTimestamp':
    case 'PgDate':
      return 'Date';
    case 'PgTimestampString':
    case 'PgDateString':
      return 'DateString';
    case 'PgNumeric':
      return 'Numeric';
    case 'PgArray':
      return 'Array';
    default:
      return 'Other';
  }
}

const quote = (name: string) => `"${name.replaceAll('"', '""')}"`;

/** A snapshot default as SQL. */
function defaultSql(raw: unknown, type: string): string {
  if (typeof raw === 'string') return `(${raw})::${type}`;
  return `(${JSON.stringify(raw)})::${type}`;
}

let out = `//! Generated by \`tools/crm-tables.mts\` from the Drizzle schema and tenant
//! snapshot ${latest}; don't edit. The tables the CRM sync engine writes
//! whatever the field mappings produced into, with the statements that write
//! a \`{ column: value }\` object as Drizzle would
//! (\`weldsuite_books_domain::table\`).

#![allow(clippy::doc_markdown, dead_code)]

use weldsuite_books_domain::table::{Column, Kind, Table};
`;

for (const exportName of TABLES) {
  const table = (schema as Record<string, unknown>)[exportName];
  if (!is(table, PgTable)) throw new Error(`${exportName} is not a table`);
  const name = getTableName(table);
  const snap = snapshot.tables[`public.${name}`];
  if (!snap) throw new Error(`${name} is not in ${latest}`);
  const columns = Object.entries(getTableColumns(table)).map(([prop, column]) => {
    const c = column as unknown as { name: string; columnType: string; defaultFn?: unknown; onUpdateFn?: unknown };
    const s = snap.columns[c.name];
    if (!s) throw new Error(`${name}.${c.name} is not in ${latest}`);
    if (c.defaultFn || c.onUpdateFn) throw new Error(`${name}.${c.name} has a $defaultFn/$onUpdate the writer does not run`);
    return { prop, name: c.name, kind: kindOf(c.columnType), type: s.type, default: s.default, defaultFn: false };
  });
  const exprs = columns.map((c) =>
    c.default === undefined
      ? `r.${quote(c.name)}`
      : `case when $1::jsonb ? '${c.name}' then r.${quote(c.name)} else ${defaultSql(c.default, c.type)} end`,
  );
  const numeric = columns.filter((c) => c.kind === 'Numeric');
  const row = numeric.length
    ? `(to_jsonb(t) || jsonb_build_object(${numeric.map((c) => `'${c.name}', t.${quote(c.name)}::text`).join(', ')}))`
    : 'to_jsonb(t)';
  const hasDeleted = columns.some((c) => c.name === 'deleted_at');
  const insert =
    `insert into ${quote(name)} as t (${columns.map((c) => quote(c.name)).join(', ')}) ` +
    `select ${exprs.join(', ')} from jsonb_populate_record(null::${quote(name)}, $1::jsonb) r returning ${row}`;
  const sets = columns
    .filter((c) => c.name !== 'id')
    .map((c) => `${quote(c.name)} = case when $1::jsonb ? '${c.name}' then r.${quote(c.name)} else t.${quote(c.name)} end`);
  const patch =
    `update ${quote(name)} as t set ${sets.join(', ')} from jsonb_populate_record(null::${quote(name)}, $1::jsonb) r ` +
    `where t.id = $2${hasDeleted ? ' and (not $3::boolean or t.deleted_at is null)' : ' and $3::boolean is not null'} returning ${row}`;
  const select = `select ${row} from ${quote(name)} as t where t.id = $1${hasDeleted ? ' and t.deleted_at is null' : ''} limit 1`;
  const constName = name.toUpperCase();
  const selectAny = `select ${row} from ${quote(name)} as t where t.id = $1 limit 1`;
  const email = columns.find((c) => c.prop === 'email');
  const byEmail = email && hasDeleted
    ? `select t.id from ${quote(name)} as t where t.${quote(email.name)} = $1 and t.deleted_at is null limit 1`
    : null;
  out += `
/// \`${exportName}\` (\`${name}\`).
pub const ${constName}: Table = Table {
    name: "${name}",
    columns: &[
${columns.map((c) => `        Column { prop: "${c.prop}", name: "${c.name}", kind: Kind::${c.kind}, default_fn: ${c.defaultFn} },`).join('\n')}
    ],
    row: ${JSON.stringify(row)},
    insert: ${JSON.stringify(insert)},
    patch: ${JSON.stringify(patch)},
    select_live: ${JSON.stringify(select)},
};

/// \`db.select().from(${exportName}).where(eq(${exportName}.id, $1)).limit(1)\`: the row, deleted or not.
pub const ${constName}_SELECT_ANY: &str = ${JSON.stringify(selectAny)};

/// The live row with this \`email\` (\`upsertByMapping\`'s dedup), when the table has that property.
pub const ${constName}_BY_EMAIL: Option<&str> = ${byEmail ? `Some(${JSON.stringify(byEmail)})` : 'None'};
`;
}

writeFileSync(path.join(here, '../src/crm/tables.rs'), out);
console.log(`wrote ${TABLES.length} tables from ${latest}`);
