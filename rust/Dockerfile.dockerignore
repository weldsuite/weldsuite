# The build context of rust/Dockerfile is the repo root (docker build -f
# rust/Dockerfile .): only what its stages read goes in, so an unrelated
# change doesn't invalidate the cache and the context stays small.
*

# The pnpm workspace, for the platform SPA, the sign and forms portals, the
# admin console, the storefront renderer and the helpdesk widget.
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!patches
!packages
!apps/web/platform
!apps/web/sign-portal
!apps/web/forms-portal
!apps/web/admin
!apps/web/storefront
!apps/web/helpdesk-widget
# The collab-rooms service bundles the workers' room classes.
!apps/tools/collab-rooms
!apps/workers/docs-api
!apps/workers/sheets-api
!apps/workers/board-api

# The Rust workspace, for the backend.
!rust/rust-toolchain.toml
!rust/Cargo.toml
!rust/Cargo.lock
!rust/clippy.toml
!rust/.cargo
!rust/catalogs
!rust/crates
!rust/modules
!rust/bins
!rust/migrations
!rust/docker

# Never: installs, build output, local state, tests.
**/node_modules
**/dist
**/target
**/.turbo
**/.wrangler
**/.env
**/.env.*
**/.dev.vars
rust/**/tests
# The migrations: only their SQL and journals, which `weldsuite migrate`
# embeds (crates/migrations/build.rs), not the snapshots (2 MB each).
rust/migrations/*/meta/*_snapshot.json
packages/core/db/drizzle
!packages/core/db/drizzle/personal-migrations/*.sql
!packages/core/db/drizzle/personal-migrations/meta/_journal.json
apps/web/platform/docs
apps/web/platform/e2e
apps/web/platform/playwright-report
apps/web/platform/test-results
apps/web/helpdesk-widget/e2e
apps/web/helpdesk-widget/playwright-report
apps/web/helpdesk-widget/test-results
