{
  "name": "weldsuite",
  "license": "AGPL-3.0-only",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:safe": "cross-env SKIP_PRISMA_GENERATE=true turbo dev",
    "dev:api": "node scripts/dev-api.mjs",
    "load-test": "node scripts/load-test/run.mjs",
    "lint": "turbo lint",
    "lint:sonar": "eslint -c eslint.sonar.config.mjs",
    "lint:sonar:new": "node scripts/lint-sonar-new.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prisma:generate": "cd packages/database && npx prisma generate",
    "check:metadata": "node scripts/check-metadata.js",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "secrets:put": "npx tsx scripts/secrets/put.ts",
    "secrets:sync": "npx tsx scripts/secrets/sync.ts",
    "secrets:dev": "npx tsx scripts/secrets/dev-vars.ts",
    "create:mobile-app": "node scripts/create-mobile-app.mjs",
    "create:module-api": "node scripts/create-module-api.mjs",
    "api:ownership": "node scripts/api-module-ownership.mjs",
    "rust:catalogs": "tsx scripts/rust-catalogs.ts",
    "rust:conformance": "tsx scripts/rust-conformance.ts",
    "rust:emails": "tsx --tsconfig packages/core/emails/tsconfig.json scripts/rust-emails.ts",
    "rust:fmt": "cd rust && cargo fmt --all",
    "rust:subscriber-fixtures": "tsx scripts/rust-subscriber-fixtures.ts",
    "rust:mail-inbound-fixtures": "tsx scripts/rust-mail-inbound-fixtures.ts",
    "rust:desk-workflow-fixtures": "cross-env WRITE_RUST_FIXTURES=1 pnpm --filter helpdesk-workflow-worker exec vitest run src/testing/rust-fixtures.test.ts",
    "rust:connect-engine-fixtures": "cross-env WRITE_RUST_FIXTURES=1 pnpm --filter workflow-worker exec vitest run src/testing/rust-fixtures.test.ts",
    "rust:lint": "cd rust && cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "rust:test": "cd rust && cargo test --workspace --locked",
    "rust:deny": "cd rust && cargo deny check",
    "audit:outbound": "pnpm --filter outbound-audit audit:outbound",
    "storybook": "turbo run dev --filter=storybook",
    "storybook:build": "turbo run storybook:build --filter=storybook"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/color": "^3.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.groupby": "^4.6.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/minimatch": "^6.0.0",
    "@types/pg": "^8.15.5",
    "@weldsuite/eslint-config": "workspace:*",
    "@weldsuite/typescript-config": "workspace:*",
    "cross-env": "^10.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "prettier": "^3.6.2",
    "turbo": "^2.9.16",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^6.4.5"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/lib-storage": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@faker-js/faker": "^10.5.0",
    "@neondatabase/serverless": "^1.0.1",
    "@stripe/stripe-js": "^7.6.1",
    "@uidotdev/usehooks": "^2.4.1",
    "color": "^4.2.3",
    "embla-carousel-autoplay": "^8.6.0",
    "emoji-picker-react": "^4.14.0",
    "firebase": "^12.1.0",
    "ioredis": "^5.7.0",
    "jotai": "^2.15.1",
    "jsonwebtoken": "^9.0.2",
    "lodash.groupby": "^4.6.0",
    "lodash.throttle": "^4.1.1",
    "postmark": "^4.0.5",
    "react": "19.2.3",
    "stripe": "^18.3.0",
    "tunnel-rat": "^0.1.2",
    "zod": "^4.1.0"
  }
}
